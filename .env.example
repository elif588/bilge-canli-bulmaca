# ==============================================================================
# TIKTOK LIVE AI TAROT - SISTEM AYARLARI
# ==============================================================================

# 1. TIKTOK CANLI YAYIN AYARLARI
# Dinlemek istediğiniz TikTok kullanıcısı (kendi kullanıcı adınız veya test yayını)
TIKTOK_USERNAME=tarotserra

# 2. YAPAY ZEKA MODELI (LLM) AYARLARI
# 'gemini' veya 'openai' seçebilirsiniz.
LLM_PROVIDER=gemini

# Google Gemini API Anahtarınız (https://aistudio.google.com/)
GEMINI_API_KEY=

# OpenAI API Anahtarınız (Opsiyonel: Eğer LLM_PROVIDER=openai ise)
OPENAI_API_KEY=

# 3. GERÇEK İNSAN SESİ (TTS) AYARLARI
# 'elevenlabs' (En gerçekçi profesyonel ses) veya 'edge-tts' (Ücretsiz yüksek kaliteli)
TTS_PROVIDER=edge-tts

# ElevenLabs API Anahtarı ve Ses ID'si (TTS_PROVIDER=elevenlabs ise)
ELEVENLABS_API_KEY=
# Mistik kadın ses örneği veya kendi klonladığınız ses ID'si:
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Edge-TTS ücretsiz kadın sesi:
# 'tr-TR-EmelNeural' (Mistik ve sakin) veya 'tr-TR-DilaraNeural'
EDGE_TTS_VOICE=tr-TR-EmelNeural

# 4. KUYRUK VE HEDİYE ÖNCELİĞİ AYARLARI
# Hediye gönderenlerin sıranın en önüne geçmesi
GIFT_PRIORITY_ENABLED=true

# Minimum hediye jetonu (1 gül = 1 jeton)
MIN_GIFT_COINS=1

# Ücretsiz yorum aralığı (saniye cinsinden bekleme)
FREE_READING_INTERVAL=10

# Aynı kullanıcının tekrar ücretsiz bakabilmesi için bekleme süresi (saniye)
USER_COOLDOWN_SECONDS=120

# 5. YEREL OBS OVERLAY SUNUCU AYARLARI
SERVER_HOST=127.0.0.1
SERVER_PORT=8765
